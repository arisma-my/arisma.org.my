{
  "name": "arisma-website",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  // Matikan alamat *.workers.dev pengeluaran supaya tiada kandungan pendua.
  "workers_dev": false,
  // MESTI ditulis eksplisit: jika tidak, nilainya mengikut workers_dev (false)
  // dan pratonton PR turut mati. Jangan tukar ke false tanpa tanya.
  "preview_urls": true,
  // Workers Builds guna `wrangler preview` (beta) untuk branch bukan-main dan
  // mewajibkan blok ini wujud. Biarkan kosong.
  "previews": {},
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
